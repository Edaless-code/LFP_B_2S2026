digraph DiagramaDeClases {
    rankdir=TB;
    fontname="Helvetica";
    fontsize=10;
    labelloc="b";
    label="\nLas flechas indican dependencia: A -> B significa que A usa B.\nNingun modulo de capas inferiores depende de capas superiores.\n";

    graph [nodesep=0.35, ranksep=0.65, pad=0.35, compound=true];
    node [shape=record, fontname="Helvetica", fontsize=9, style=filled, fillcolor="#ffffff"];
    edge [fontname="Helvetica", fontsize=8, arrowsize=0.7, color="#5b6670"];

    subgraph cluster_interfaz {
        label="interfaz  (presentacion)";
        fontsize=11; fontname="Helvetica"; color="#86aee3"; style=rounded;
        App [label="{AplicacionHorarioScript|+ mainloop()\l- _abrir_archivo()\l- _analizar()\l- _limpiar()\l- _abrir_reporte(clave)\l- _exportar_csv()\l- _exportar_json()\l}"];
    }

    subgraph cluster_servicios {
        label="servicios / reportes  (entrada y salida)";
        fontsize=11; fontname="Helvetica"; color="#7cc496"; style=rounded;
        Cargador [label="{CargadorArchivos|+ cargar(ruta) : str\l+ validar_extension(ruta) : bool\l}"];
        GenRep [label="{GeneradorReportes|+ generar_todos(...) : dict\l- _escribir(nombre, html)\l}"];
    }

    subgraph cluster_horario {
        label="horario  (dominio)";
        fontsize=11; fontname="Helvetica"; color="#e3b167"; style=rounded;
        Constructor [label="{ConstructorHorario|+ construir() : Horario\l- _leer_atributos() : dict\l- _leer_valor() : str\l}"];
        Detector [label="{DetectorChoques|+ detectar() : lista de Choque\l+ clases_en_choque() : set\l- _comparar(a, b)\l}"];
    }

    subgraph cluster_analizador {
        label="analizador  (motor lexico)";
        fontsize=11; fontname="Helvetica"; color="#e08a8a"; style=rounded;
        Lexico [label="{AnalizadorLexico|- _texto : str\l- _pos : int\l- _linea : int\l- _columna : int\l|+ siguiente_token() : Token\l+ analizar_todo() : lista de Token\l+ reiniciar()\l- _avanzar() : str\l- _leer_palabra_o_codigo()\l- _leer_numero_u_hora()\l- _leer_cadena()\l- _leer_comentario()\l}"];
        Gestor [label="{GestorErrores|+ registrar(tipo, lexema, l, c)\l+ errores : list\l+ hay_errores : bool\l+ total : int\l+ limpiar()\l}"];
    }

    subgraph cluster_modelos {
        label="modelos  (datos, sin logica)";
        fontsize=11; fontname="Helvetica"; color="#b4bcc4"; style=rounded;
        Token [label="{Token|+ numero : int\l+ lexema : str\l+ tipo : TipoToken\l+ linea : int\l+ columna : int\l|+ a_fila() : tuple\l}"];
        TipoToken [label="{&laquo;enum&raquo; TipoToken|13 valores\l}"];
        ErrorLex [label="{ErrorLexico|+ numero, lexema\l+ tipo : TipoError\l+ descripcion : str\l+ linea, columna\l|+ a_fila() : tuple\l}"];
        TipoError [label="{&laquo;enum&raquo; TipoError|7 categorias\l}"];
        Horario [label="{Horario|+ cursos : dict\l+ catedraticos : dict\l+ aulas : dict\l+ clases : list\l}"];
        Clase [label="{Clase|+ codigo_curso\l+ codigo_catedratico\l+ codigo_aula\l+ dia, inicio, fin\l+ seccion, linea\l|+ inicio_minutos\l+ fin_minutos\l+ duracion_minutos\l}"];
        Choque [label="{Choque|+ numero, tipo\l+ recurso\l+ clase_a, clase_b\l+ descripcion\l|+ a_fila() : tuple\l}"];
    }

    App -> Cargador;
    App -> Lexico;
    App -> Constructor;
    App -> Detector;
    App -> GenRep;

    Lexico -> Gestor;
    Lexico -> Token;
    Gestor -> ErrorLex;
    Token -> TipoToken;
    ErrorLex -> TipoError;

    Constructor -> Token [style=dashed, label="consume"];
    Constructor -> Horario;
    Horario -> Clase [arrowhead=diamond, label="1..*"];
    Detector -> Horario;
    Detector -> Choque;
    Choque -> Clase [style=dashed];
    GenRep -> Horario;
    GenRep -> Choque [style=dashed];
    GenRep -> ErrorLex [style=dashed];
}
